{
  "schema": "tensorpilot.gpu-experiments/v1",
  "suite": "v1.0-0.5b-serial",
  "target": {
    "model": "Qwen/Qwen2.5-0.5B-Instruct",
    "revision": "7ae557604adf67be50417f59c2c2f167def9a775",
    "license": "Apache-2.0",
    "prompt_format": "raw text, tokenizer default special tokens (no chat template)",
    "engine": "tensorpilot",
    "execution": "serial",
    "quantization": "none",
    "dtype": "float16",
    "max_prompt_tokens": 1024
  },
  "assumptions": {
    "status": "placeholder_unmeasured",
    "decode_tokens_per_s": 58,
    "prefill_tokens_per_s": 2000,
    "single_stream_source": "measured on an RTX 4090 with the serial worker (v0.9.1-4)",
    "batching_efficiency_exponent": 0.8,
    "note": "planning numbers only; the experiment caps, not these estimates, bound cost"
  },
  "session_overhead_minutes": 5,
  "max_session_minutes": 26,
  "expected_experiment_minutes": 5.0,
  "telemetry": {
    "interval_s": 1.0
  },
  "experiments": [
    {
      "id": "cold-start",
      "kind": "closed_loop",
      "description": "the first requests after readiness, before any warmup request: cold-start latency",
      "requests": 8,
      "concurrency": 1,
      "repeats": 1,
      "warmup_requests": 0,
      "timeout_s": 120,
      "workload_spec": {
        "seed": 11,
        "classes": [
          {
            "name": "short",
            "prompt_tokens": {
              "dist": "uniform",
              "min": 16,
              "max": 64
            },
            "output_tokens": {
              "dist": "uniform",
              "min": 16,
              "max": 64
            },
            "weight": 1
          }
        ]
      },
      "estimated_minutes": 0.6,
      "max_minutes": 5,
      "abort_error_rate": 0.5
    },
    {
      "id": "regression-c1",
      "kind": "closed_loop",
      "description": "the v0.9.1-4 baseline workload shape, to confirm no regression",
      "requests": 40,
      "concurrency": 1,
      "repeats": 3,
      "warmup_requests": 4,
      "timeout_s": 120,
      "workload_spec": {
        "seed": 10,
        "classes": [
          {
            "name": "regression",
            "prompt_tokens": 17,
            "output_tokens": 32
          }
        ]
      },
      "estimated_minutes": 1.8,
      "max_minutes": 7,
      "abort_error_rate": 0.5,
      "slo": {
        "ttft_s": 1.0,
        "e2e_s": 10.0,
        "tpot_s": 0.05
      }
    },
    {
      "id": "serial-c8",
      "kind": "closed_loop",
      "description": "eight clients against the serial worker: queueing, not batching",
      "requests": 80,
      "concurrency": 8,
      "repeats": 2,
      "warmup_requests": 4,
      "timeout_s": 120,
      "workload_spec": {
        "seed": 11,
        "classes": [
          {
            "name": "short",
            "prompt_tokens": {
              "dist": "uniform",
              "min": 16,
              "max": 64
            },
            "output_tokens": {
              "dist": "uniform",
              "min": 16,
              "max": 64
            },
            "weight": 1
          }
        ]
      },
      "estimated_minutes": 2.6,
      "max_minutes": 9,
      "abort_error_rate": 0.5,
      "slo": {
        "ttft_s": 1.0,
        "e2e_s": 10.0,
        "tpot_s": 0.05
      }
    }
  ]
}
