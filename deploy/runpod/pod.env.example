# Copy to pod.env on the Pod for local use, or enter these in Runpod's environment settings.
# Never commit a filled-in copy. Put TENSORPILOT_API_KEY in Runpod's secret store.
TENSORPILOT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
TENSORPILOT_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
TENSORPILOT_PORT=8080
TENSORPILOT_CACHE_DIR=/workspace/huggingface
TENSORPILOT_RESULTS=/workspace/results
TENSORPILOT_BENCH_CONFIG=benchmarks/gpu/v09-single-gpu.json
TENSORPILOT_BENCH_TIMEOUT=3h
# TENSORPILOT_API_KEY=   (set from a secret; required)
