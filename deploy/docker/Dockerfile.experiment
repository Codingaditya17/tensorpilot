# TensorPilot experiment Pod image: the published production worker image plus SSH, the session
# scripts and the benchmark configs. The production image (Dockerfile.cuda) is not modified; this
# layer only adds files and an SSH entrypoint, and is published as a separate package.
#
# Base pinned by digest: ghcr.io/codingaditya17/tensorpilot/cuda:v0.9.1. Update deliberately.
ARG BASE=ghcr.io/codingaditya17/tensorpilot/cuda@sha256:afdc5dc6646040cb486654cc6722a20f2d21a9c080f96ac5f33145a6a1da825a
FROM ${BASE}

# Root is required only for the entrypoint to start sshd and prepare /workspace. Every TensorPilot
# process runs as the unprivileged tensorpilot user after an SSH login.
# hadolint ignore=DL3002,DL3066
USER root
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server curl ca-certificates procps less tmux \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd \
 && usermod --shell /bin/bash --password '*' tensorpilot

# The base image predates NF4 quantization. Installing the hash-locked CUDA requirements adds only what is missing
# (bitsandbytes, accelerate, psutil); everything already installed at the locked version is left alone.
COPY requirements-cuda.txt /tmp/requirements-cuda.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-cuda.txt \
 && rm /tmp/requirements-cuda.txt

# The experiment runs the tensorpilot source of the commit this image is built from, installed over the
# base image's copy (dependencies are already in the base). The production image is not modified, so
# a production tag keeps the code it was built with until a production release is cut deliberately.
# The base image also keeps its source in /app, which Python would load first from that directory, so the
# stale copy is removed in this layer only (the base layers are unchanged) and the check runs in isolated mode, which ignores the working directory.
COPY pyproject.toml README.md /tmp/tensorpilot-src/
COPY tensorpilot /tmp/tensorpilot-src/tensorpilot
RUN python -m pip install --no-deps --no-cache-dir --force-reinstall /tmp/tensorpilot-src \
 && rm -rf /tmp/tensorpilot-src /app/tensorpilot \
 && python -I -c "import tensorpilot.cuda_backend as m; assert m.__file__.startswith('/usr/local/lib/'), m.__file__; m.resolve_cuda_device"

# Read-only, root-owned. Runtime output goes to /workspace, never here.
COPY deploy/runpod /opt/tensorpilot/deploy/runpod
COPY benchmarks/gpu /opt/tensorpilot/benchmarks/gpu
COPY docs/v09-runpod-runbook.md docs/v09-runpod-experiment-pod.md /opt/tensorpilot/docs/
COPY deploy/runpod/pod_sshd_config /etc/ssh/sshd_config
RUN chmod 0755 /opt/tensorpilot/deploy/runpod/*.sh && chmod 0644 /etc/ssh/sshd_config

# First experiment: measured work is capped by the benchmark timeout; the whole run by the session cap.
# Evidence and cache directories are chosen at start by pod-entrypoint.sh (a verified writable
# location) and exported to SSH sessions; they are deliberately not fixed here.
ENV TENSORPILOT_BENCH_CONFIG=benchmarks/gpu/v09-first-30min.json \
    TENSORPILOT_BENCH_TIMEOUT=25m \
    TENSORPILOT_SESSION_CAP=45m \
    TENSORPILOT_POD_MAX_MINUTES=120

# sshd is the only listener. TensorPilot binds 127.0.0.1 and is reached through SSH.
EXPOSE 22
VOLUME ["/workspace"]
WORKDIR /opt/tensorpilot

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/22"]

ARG SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision=$SOURCE_SHA

ENTRYPOINT ["/opt/tensorpilot/deploy/runpod/pod-entrypoint.sh"]
STOPSIGNAL SIGTERM
